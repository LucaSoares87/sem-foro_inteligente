POSTGRES_DB=traffic
POSTGRES_USER=traffic
POSTGRES_PASSWORD=
APP_ENV=development
WEB_PORT=5173
VIDEO_SOURCES_JSON=[]
# VIDEO_HOST_DIR=/path/to/authorized/video
VISION_MODEL_JSON=
# VISION_HOST_DIR=/path/to/authorized/models
TRAFFIC_GEOMETRY_JSON=[]
INTERSECTION_REGISTRY_JSON=[]
AUTH_MODE=disabled
AUTH_USER_HEADER=x-si-user
AUTH_ROLES_HEADER=x-si-roles
AUDIT_ENABLED=true
# Production requires APP_ENV=production, AUTH_MODE=proxy_headers and explicit HTTPS origin(s).
# A trusted corporate ingress must strip client-supplied X-SI-* headers and inject identity claims.
# ALLOWED_ORIGINS=https://traffic.example.gov.br
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=1.0
VALIDATION_EVIDENCE_JSON=[]
